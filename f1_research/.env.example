# ============================================================
# F1 Autonomous Research Program - Environment Configuration
# ============================================================

# --- LLM Backend Selection ---
# Options: "ollama" | "openrouter" | "groq"
LLM_BACKEND=groq

# --- Ollama Settings (if using ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_FAST_MODEL=llama3.2:3b

# --- OpenRouter Settings (if using openrouter) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Groq Settings (if using groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- Research Configuration ---
F1_SEASON=2025
RESEARCH_DEPTH=deep          # light | medium | deep
RESEARCH_INTERVAL_HOURS=6   # how often to run automated research
PUBLISH_INSIGHTS=true        # auto-publish findings to insights/

# --- Logging ---
LOG_LEVEL=DEBUG
LOG_TO_FILE=true
ENABLE_AGENT_CONVERSATION_LOG=true
ENABLE_TOOL_CALL_LOG=true
ENABLE_LLM_RESPONSE_LOG=true

# --- FastF1 Cache ---
FASTF1_CACHE_DIR=./telemetry_cache
