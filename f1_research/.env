# ============================================================
# F1 Autonomous Research Program - Environment Configuration
# ============================================================

# --- LLM Backend Selection ---
# Options: "ollama" | "openrouter" | "groq"
LLM_BACKEND=ollama
LLM_BACKEND_ORDER=ollama,openrouter,groq

# --- Ollama Settings (if using ollama) ---
OLLAMA_BASE_URL=http://10.10.16.46:11435
OLLAMA_MODEL=qwen2.5:32b
OLLAMA_FAST_MODEL=qwen2.5:32b

# --- OpenRouter Settings (if using openrouter) ---
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FAST_MODEL=openai/gpt-4o-mini

# --- Groq Settings (if using groq) ---
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.3-70b-versatile

# --- Research Configuration ---
F1_SEASON=2026
RESEARCH_DEPTH=deep          # light | medium | deep
RESEARCH_INTERVAL_HOURS=6   # how often to run automated research
PUBLISH_INSIGHTS=true        # auto-publish findings to insights/

# --- Logging ---
LOG_LEVEL=DEBUG
LOG_TO_FILE=true
ENABLE_AGENT_CONVERSATION_LOG=true
ENABLE_TOOL_CALL_LOG=true
ENABLE_LLM_RESPONSE_LOG=true

# --- FastF1 Cache ---
FASTF1_CACHE_DIR=./telemetry_cache
